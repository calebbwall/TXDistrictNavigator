entrypoint = "README.md"
modules = ["nodejs-22"]

[nix]
channel = "stable-24_05"

[deployment]
deploymentTarget = "autoscale"
build = ["bash", "-c", "npm run server:build"]
run = ["bash", "-c", "npx drizzle-kit push --force && npm run server:prod"]

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 9999
externalPort = 3001

[[ports]]
localPort = 19000
externalPort = 3000

[agent]
stack = "EXPO"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Start App"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm install && npx drizzle-kit push --force && npm run dev"
waitForPort = 8081

[[workflows.workflow]]
name = "Start Production"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "sleep 20; if command -v lsof >/dev/null 2>&1 && lsof -iTCP:8081 -sTCP:LISTEN >/dev/null 2>&1; then echo \"[Start Production] Port 8081 already bound — skipping (Start App is running).\"; exit 0; fi; set -e; npm install; npm run server:build; npx drizzle-kit push --force; if command -v lsof >/dev/null 2>&1 && lsof -iTCP:8081 -sTCP:LISTEN >/dev/null 2>&1; then echo \"[Start Production] Port 8081 bound during build — skipping bind.\"; exit 0; fi; npm run server:prod"
waitForPort = 8081

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start App"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start Production"

[postMerge]
path = ".local/post-merge.sh"
timeoutMs = 120000
